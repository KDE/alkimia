@PACKAGE_INIT@

list(APPEND CMAKE_MODULE_PATH "${CMAKE_CURRENT_LIST_DIR}")

include(CMakeFindDependencyMacro)

find_dependency(@MP_CMAKE_MODULE@)
find_dependency(Qt@QT_MAJOR_VERSION@ @QT_MIN_VERSION@ COMPONENTS @CMAKECONFIG_QT_COMPONENTS@)
# FindKF5/6.cmake is only provided by ECM, this dep needs to be ensure here and its find modules being in the cmake module path
# before trying find_dependency(KF5/6 COMPONENTS ...)
# find_dependency(KF@QT_MAJOR_VERSION@ @KF_MIN_VERSION@ COMPONENTS @CMAKECONFIG_KF_COMPONENTS@)
# better directly search the modules, like this (not possible with kde4libs though)
find_dependency(KF@QT_MAJOR_VERSION@Config @KF_MIN_VERSION@)

include("${CMAKE_CURRENT_LIST_DIR}/LibAlkimia@ALKIMIA_PATH_SUFFIX@Targets.cmake")
message(STATUS "Found LibAlkimia: ${CMAKE_CURRENT_LIST_DIR}/LibAlkimia@ALKIMIA_PATH_SUFFIX@Config.cmake (version \"@PROJECT_VERSION@\")")
